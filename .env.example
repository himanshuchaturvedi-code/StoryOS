# Single source of truth: keep this file at repo root only.
# Do NOT create packages/database/.env — it causes conflicts.

# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storyos_dev"

# ──────────────────────────────────────────
# API (apps/api)
# ──────────────────────────────────────────
NODE_ENV="development"
PORT=3001

# JWT — change in production, minimum 32 characters
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ──────────────────────────────────────────
# Web (apps/web)
# ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

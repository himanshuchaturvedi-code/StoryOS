{
  "name": "@storyos/program-registry",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc && rm -rf dist/cptc && cp -r cptc dist/cptc",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "@storyos/types": "*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "diagnostics": { "ignoreCodes": [151001] } }]
    },
    "moduleNameMapper": {
      "^@storyos/types(.*)$": "<rootDir>/../../types/src$1"
    },
    "testEnvironment": "node"
  }
}

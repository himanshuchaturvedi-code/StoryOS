{
  "name": "storyos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "npm run generate --workspace=packages/database && npm run build --workspace=packages/database",
    "db:migrate": "npm run migrate:dev --workspace=packages/database",
    "db:migrate:prod": "npm run migrate:prod --workspace=packages/database",
    "db:deploy": "npm run migrate:deploy --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "validate-program-config": "npm run validate-program-config --workspace=packages/database",
    "db:studio": "npm run studio --workspace=packages/database",
    "dev:setup": "npm run db:migrate && npm run db:seed",
    "import:telefilm": "ts-node scripts/import-telefilm-template.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^17.3.1",
    "eslint": "^9.17.0",
    "ts-node": "^10.9.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.2"
}
